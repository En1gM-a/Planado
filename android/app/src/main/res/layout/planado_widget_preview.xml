<?xml version="1.0" encoding="utf-8"?>
<!-- Static sample shown in the launcher's widget picker (Android 12+). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/planado_widget_background"
  android:clipToOutline="true"
  android:orientation="vertical"
  android:paddingStart="16dp"
  android:paddingTop="14dp"
  android:paddingEnd="12dp"
  android:paddingBottom="12dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
      android:layout_width="46dp"
      android:layout_height="48dp">

      <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/planado_widget_tile"
        android:tint="@color/planado_widget_accent_soft" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:includeFontPadding="false"
          android:letterSpacing="0.06"
          android:text="TUE"
          android:textColor="@color/planado_widget_accent"
          android:textSize="11sp"
          android:textStyle="bold" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:includeFontPadding="false"
          android:text="20"
          android:textColor="@color/planado_widget_accent"
          android:textSize="19sp"
          android:textStyle="bold" />
      </LinearLayout>
    </FrameLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="Weekend crew"
        android:textColor="@color/planado_widget_ink"
        android:textSize="16sp"
        android:textStyle="bold" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        android:text="2 plans today · next 2:00 PM"
        android:textColor="@color/planado_widget_muted"
        android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:layout_marginStart="8dp">

      <ImageView
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/planado_widget_circle"
        android:tint="@color/planado_widget_accent" />

      <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_planado_widget_add" />
    </FrameLayout>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/planado_widget_chip"
    android:gravity="center_vertical"
    android:minHeight="32dp"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="5dp"
    android:paddingEnd="5dp"
    android:paddingBottom="5dp">

    <ImageView
      android:layout_width="16dp"
      android:layout_height="16dp"
      android:importantForAccessibility="no"
      android:src="@drawable/ic_planado_widget_star" />

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:maxLines="1"
      android:text="Beach trip"
      android:textColor="@color/planado_widget_ink"
      android:textSize="13sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:background="@drawable/planado_widget_pill"
      android:paddingStart="9dp"
      android:paddingTop="3dp"
      android:paddingEnd="9dp"
      android:paddingBottom="3dp"
      android:text="3 days"
      android:textColor="@color/planado_widget_important"
      android:textSize="12sp"
      android:textStyle="bold" />
  </LinearLayout>

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:letterSpacing="0.08"
    android:text="TODAY"
    android:textColor="@color/planado_widget_accent"
    android:textSize="12sp"
    android:textStyle="bold" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="36dp"
    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <ImageView
      android:layout_width="4dp"
      android:layout_height="30dp"
      android:importantForAccessibility="no"
      android:scaleType="fitXY"
      android:src="@drawable/planado_widget_bar"
      android:tint="@color/planado_widget_accent" />

    <TextView
      android:layout_width="66dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:maxLines="1"
      android:text="9:00 AM"
      android:textColor="@color/planado_widget_muted"
      android:textSize="12sp"
      android:textStyle="bold" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="4dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="Study session"
        android:textColor="@color/planado_widget_ink"
        android:textSize="14sp"
        android:textStyle="bold" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="Library, 3rd floor"
        android:textColor="@color/planado_widget_muted"
        android:textSize="12sp" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="36dp"
    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <ImageView
      android:layout_width="4dp"
      android:layout_height="30dp"
      android:importantForAccessibility="no"
      android:scaleType="fitXY"
      android:src="@drawable/planado_widget_bar"
      android:tint="@color/planado_green" />

    <TextView
      android:layout_width="66dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:maxLines="1"
      android:text="2:00 PM"
      android:textColor="@color/planado_widget_muted"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="4dp"
      android:layout_weight="1"
      android:maxLines="1"
      android:text="Lunch with the team"
      android:textColor="@color/planado_widget_ink"
      android:textSize="14sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
