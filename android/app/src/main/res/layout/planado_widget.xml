<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/planado_widget_background"
  android:clipToOutline="true"
  android:orientation="vertical"
  android:paddingStart="16dp"
  android:paddingTop="14dp"
  android:paddingEnd="12dp"
  android:paddingBottom="12dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
      android:layout_width="46dp"
      android:layout_height="48dp">

      <ImageView
        android:id="@+id/widget_date_tile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/planado_widget_tile"
        android:tint="@color/planado_widget_accent_soft" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
          android:id="@+id/widget_date_weekday"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:includeFontPadding="false"
          android:letterSpacing="0.06"
          android:text="TUE"
          android:textColor="@color/planado_widget_accent"
          android:textSize="11sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/widget_date_day"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:includeFontPadding="false"
          android:text="20"
          android:textColor="@color/planado_widget_accent"
          android:textSize="19sp"
          android:textStyle="bold" />
      </LinearLayout>
    </FrameLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/widget_group_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Planado"
        android:textColor="@color/planado_widget_ink"
        android:textSize="16sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/widget_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Today and tomorrow at a glance"
        android:textColor="@color/planado_widget_muted"
        android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
      android:id="@+id/widget_add"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:layout_marginStart="8dp"
      android:contentDescription="Create event">

      <ImageView
        android:id="@+id/widget_add_fill"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/planado_widget_circle"
        android:tint="@color/planado_widget_accent" />

      <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_planado_widget_add" />
    </FrameLayout>
  </LinearLayout>

  <TextView
    android:id="@+id/widget_setup_hint"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:text="Loading your plans…"
    android:textColor="@color/planado_widget_muted"
    android:textSize="13sp" />

  <LinearLayout
    android:id="@+id/widget_important_list"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/widget_today_section"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
      android:id="@+id/widget_today_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:letterSpacing="0.08"
      android:text="TODAY"
      android:textColor="@color/planado_widget_accent"
      android:textSize="12sp"
      android:textStyle="bold" />

    <LinearLayout
      android:id="@+id/widget_today_list"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:orientation="vertical" />

    <TextView
      android:id="@+id/widget_today_empty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="Your day is wide open."
      android:textColor="@color/planado_widget_muted"
      android:textSize="13sp"
      android:visibility="gone" />

    <TextView
      android:id="@+id/widget_today_more"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="14dp"
      android:text="+2 more"
      android:textColor="@color/planado_widget_muted"
      android:textSize="12sp"
      android:textStyle="bold"
      android:visibility="gone" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/widget_tomorrow_section"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
      android:id="@+id/widget_tomorrow_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:letterSpacing="0.08"
      android:text="TOMORROW"
      android:textColor="@color/planado_widget_muted"
      android:textSize="12sp"
      android:textStyle="bold" />

    <LinearLayout
      android:id="@+id/widget_tomorrow_list"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:orientation="vertical" />

    <TextView
      android:id="@+id/widget_tomorrow_empty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="Nothing planned"
      android:textColor="@color/planado_widget_muted"
      android:textSize="13sp"
      android:visibility="gone" />

    <TextView
      android:id="@+id/widget_tomorrow_more"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="14dp"
      android:text="+1 more"
      android:textColor="@color/planado_widget_muted"
      android:textSize="12sp"
      android:textStyle="bold"
      android:visibility="gone" />
  </LinearLayout>
</LinearLayout>
